
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:label="Donut4U Karaoke"
        android:icon="@drawable/donut4u_icon"
        android:roundIcon="@drawable/donut4u_icon"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5625332026157890~7539407143" />

        <activity
            android:name=".Stage3KaraokeMakerActivity"
            android:exported="false"
            android:hardwareAccelerated="true" />

        <activity
            android:name=".Stage3PlayerActivity"
            android:exported="false"
            android:hardwareAccelerated="true" />

        <activity
            android:name=".Stage3QueueActivity"
            android:exported="false" />

        <activity
            android:name=".Stage3SongbookActivity"
            android:exported="false" />

        <activity
            android:name=".KaraokeStudioActivity"
            android:exported="false"
            android:hardwareAccelerated="true" />

        <activity
            android:name=".OnlineSongActivity"
            android:exported="false" />

        <activity
            android:name=".AuthActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
